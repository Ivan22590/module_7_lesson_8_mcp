# Telegram Bot
TELEGRAM_API_TOKEN=your_telegram_bot_token_here

# ProxyAPI (LLM)
PROXYAPI_API_KEY=your_proxyapi_key_here

# MCP Server URL (по умолчанию локальный)
MCP_SERVER_URL=http://localhost:8000

# LLM Model (ProxyAPI model ID)
LLM_MODEL=openai/gpt-5.6-luna

# Прокси для Telegram Bot API (если api.telegram.org недоступен)
# Раскомментируйте и укажите ваш прокси:
# TELEGRAM_PROXY_URL=http://127.0.0.1:8080
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
